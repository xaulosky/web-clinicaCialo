---
import type { CategoriaInfo } from "@/data/categorias";

interface Props {
  category: CategoriaInfo;
  treatmentCount?: number;
}

const { category, treatmentCount = 0 } = Astro.props as Props;
---

<a
  href={`/tratamientos/categoria/${category.slug}/`}
  class="group relative overflow-hidden rounded-[2rem] border border-cialo-gold/15 bg-white p-6 shadow-[0_24px_60px_-40px_rgba(29,29,29,0.45)] transition duration-300 hover:-translate-y-1 hover:border-cialo-gold/40"
>
  <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-cialo-gold via-cialo-almond to-transparent"></div>
  <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-cialo-gold/12 text-cialo-gold transition group-hover:bg-cialo-dark group-hover:text-white">
    <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d={category.iconPath}></path>
    </svg>
  </div>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-2xl leading-tight">{category.nombre}</h3>
      <p class="mt-3 text-sm leading-7 text-cialo-gray">{category.descripcion}</p>
    </div>
    <span class="rounded-full bg-cialo-light px-3 py-1 text-xs font-semibold text-cialo-dark">
      {treatmentCount}
    </span>
  </div>
  <p class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-cialo-dark transition group-hover:text-cialo-gold">
    Ver categoría
    <svg class="h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12h14m-6-6 6 6-6 6"></path>
    </svg>
  </p>
</a>
