---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const {
  eyebrow,
  title,
  description,
  align = "left"
} = Astro.props as Props;

const wrapperClass =
  align === "center" ? "mx-auto max-w-3xl text-center" : "max-w-3xl";
---

<div class={wrapperClass}>
  {eyebrow && (
    <p class="text-xs font-semibold uppercase tracking-[0.35em] text-cialo-gold">
      {eyebrow}
    </p>
  )}
  <h2 class="mt-3 text-4xl leading-tight text-cialo-dark md:text-5xl">
    {title}
  </h2>
  {description && (
    <p class="mt-4 text-base leading-8 text-cialo-gray md:text-lg">
      {description}
    </p>
  )}
</div>
