---
import { tratamientoRequiereEvaluacion, type Tratamiento } from "@/data/tratamientos";
import {
  cleanDescription,
  formatCurrency,
  getCategoryHref,
  getTreatmentHref
} from "../../lib/site";

interface Props {
  treatment: Tratamiento;
}

const { treatment } = Astro.props as Props;

const description = cleanDescription(treatment.descripcion);
const href = getTreatmentHref(treatment);
const requiresEvaluation = tratamientoRequiereEvaluacion(treatment);
---

<article class="group flex h-full flex-col rounded-[2rem] border border-cialo-gold/15 bg-white p-6 shadow-[0_24px_60px_-42px_rgba(29,29,29,0.5)] transition duration-300 hover:-translate-y-1 hover:border-cialo-gold/40">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-cialo-gold">
        {treatment.categoria} · {treatment.subcategoria}
      </p>
      <h3 class="mt-3 text-2xl leading-tight text-cialo-dark transition group-hover:text-cialo-gold">
        {treatment.nombre}
      </h3>
    </div>
    <span class={`rounded-full px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] ${
      requiresEvaluation
        ? "bg-cialo-dark text-white"
        : "bg-emerald-50 text-emerald-700"
    }`}>
      {requiresEvaluation ? "Evaluación" : "Online"}
    </span>
  </div>

  <p class="mt-4 text-sm leading-7 text-cialo-gray">
    {description}
  </p>

  <div class="mt-5 grid grid-cols-2 gap-3 rounded-[1.5rem] bg-cialo-light p-4 text-sm">
    <div>
      <p class="text-xs uppercase tracking-[0.2em] text-cialo-gray">Valor</p>
      <p class="mt-1 font-semibold text-cialo-dark">
        {formatCurrency(treatment.valorDesde, treatment.valorHasta)}
      </p>
    </div>
    <div>
      <p class="text-xs uppercase tracking-[0.2em] text-cialo-gray">Duración</p>
      <p class="mt-1 font-semibold text-cialo-dark">{treatment.duracion}</p>
    </div>
  </div>

  <div class="mt-5 flex flex-wrap gap-2">
    {
      treatment.tags.slice(0, 3).map((tag) => (
        <span class="rounded-full border border-cialo-gold/15 px-3 py-1 text-xs text-cialo-gray">
          {tag}
        </span>
      ))
    }
  </div>

  <div class="mt-6 flex flex-wrap gap-3">
    <a
      href={href}
      class="inline-flex items-center gap-2 rounded-full bg-cialo-dark px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-cialo-gold hover:text-cialo-dark"
    >
      Ver tratamiento
    </a>
    <a
      href={getCategoryHref(treatment.categoria)}
      class="inline-flex items-center gap-2 rounded-full border border-cialo-gold/25 px-4 py-2.5 text-sm font-medium text-cialo-dark transition hover:border-cialo-dark hover:bg-cialo-light"
    >
      Más de {treatment.categoria}
    </a>
  </div>
</article>
