<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Dominio único: www.cialo.cl → https://cialo.cl en un solo salto (http o https).
  # Se excluye /.well-known/ para no romper la renovación automática del SSL.
  RewriteCond %{HTTP_HOST} ^www\.cialo\.cl$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://cialo.cl%{REQUEST_URI} [L,R=301]

  # Forzar HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── Redirecciones 301 de URLs antiguas ──────────────────────────────────
  # Direcciones que estuvieron indexadas y ya no existen. Van ANTES del resto
  # para que no lleguen al ErrorDocument 404.
  # Nota: con `output: 'export'` Next.js ignora redirects() de next.config.ts,
  # así que este es el único sitio donde una redirección surte efecto.
  # Añadir nuevas parejas aquí, una por línea.

  # La landing perdió el "en" del slug; la antigua seguía dando 404.
  RewriteRule ^depilacion-laser-en-los-angeles/?$ /depilacion-laser-los-angeles/ [R=301,L]

  # Solución para "Next.js Static Export RSC 404s"
  # Redirige solicitudes extrañas de Next.js (prefetch) al archivo de datos real (index.txt)
  RewriteRule ^(.*)/__next\..*\.txt$ $1/index.txt [L]

  # Manejo de errores 404 personalizado (Next.js genera 404.html)
  ErrorDocument 404 /404.html

  # Opcional: Eliminar extensiones .html de la URL (si existieran archivos planos)
  # RewriteCond %{THE_REQUEST} ^GET\ (.*)\.html\ HTTP
  # RewriteRule (.*)\.html$ $1 [R=301,L]
</IfModule>

# Opciones de caché para activos estáticos (opcional pero recomendado)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  # HTML pages - revalidate always
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresDefault "access plus 2 days"
</IfModule>

# Force cache revalidation for HTML
<IfModule mod_headers.c>
  # HTML files: no cache, always revalidate
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
  
  # Static assets with hashes: cache forever (Next.js adds hashes to filenames)
  <FilesMatch "\.(css|js|woff2|woff|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Images: cache for 1 year
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
